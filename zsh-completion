#compdef punch punch.py

_punch_completion() {
  emulate -L zsh
  setopt extendedglob
  local command="${words[2]:-}" cur="${words[CURRENT]}" prev="${words[CURRENT-1]:-}"
  local -a commands config_commands dates options args
  commands=(start add report export login submit config help weeklyeditor whats-new tutorial)
  config_commands=(show edit path set get wizard)
  dates=(today yesterday tomorrow monday tuesday wednesday thursday friday saturday sunday)

  if (( CURRENT == 2 )); then
    compadd -- "${commands[@]}" --help --install-completion --show-completion
    return
  fi

  case "$command" in
    start|add) options=(-t --time -v --verbose --help) ;;
    report) options=(-d --day -f --from -t --to --help) ;;
    export) options=(-d --day -f --from -t --to --format -o --output -v --verbose --help) ;;
    submit) options=(-d --day -f --from -t --to -n --dry-run --headed -i --interactive -r --resume --sleep -v --verbose --help) ;;
    login|weeklyeditor) options=(-v --verbose --help) ;;
    tutorial|whats-new|help) options=(--help) ;;
    config)
      if (( CURRENT == 3 )); then
        compadd -- "${config_commands[@]}" --help
        return
      fi
      case "${words[3]}" in
        show|edit|path|set|get|wizard) options=(-v --verbose --help) ;;
        *) return ;;
      esac
      ;;
    *) return ;;
  esac

  case "$command:$cur" in
    export:--format=*) compset -P '*='; compadd -- json csv; return ;;
    export:--output=*) compset -P '*='; _files; return ;;
    report:--day=*|report:--from=*|report:--to=*|\
    submit:--day=*|submit:--from=*|submit:--to=*|export:--day=*)
      compset -P '*='
      compadd -- "${dates[@]}"
      return
      ;;
  esac
  case "$command:$prev" in
    export:--format) compadd -- json csv; return ;;
    export:-o|export:--output) _files; return ;;
    report:-d|report:--day|report:-f|report:--from|report:-t|report:--to|\
    submit:-d|submit:--day|submit:-f|submit:--from|submit:-t|submit:--to|\
    export:-d|export:--day)
      compadd -- "${dates[@]}"
      return
      ;;
    start:-t|start:--time|add:-t|add:--time|export:-f|export:--from|\
    export:-t|export:--to|submit:--sleep) return ;;
  esac

  if [[ "$cur" == -* ]]; then
    compadd -- "${options[@]}"
    return
  fi

  case "$command" in
    help)
      if (( CURRENT == 3 )); then
        compadd -- "${commands[@]}"
      elif (( CURRENT == 4 )) && [[ "${words[3]}" == config ]]; then
        compadd -- "${config_commands[@]}"
      fi
      return
      ;;
    config)
      if [[ "${words[3]}" != get && "${words[3]}" != set ]]; then
        return
      fi
      local word
      for word in "${(@)words[4,CURRENT-1]}"; do
        [[ "$word" == -v || "$word" == --verbose ]] || return 0
      done
      ;;
    add) ;;
    *) return ;;
  esac

  local snap_dir="$HOME/snap/punch/current" config_file tasks_file
  if [[ -n "${PUNCH_CONFIG_DIR:-}" ]]; then
    config_file="$PUNCH_CONFIG_DIR/punch.yaml"
  elif [[ -f "$snap_dir/.config/punch/punch.yaml" ]]; then
    config_file="$snap_dir/.config/punch/punch.yaml"
  else
    config_file="${XDG_CONFIG_HOME:-$HOME/.config}/punch/punch.yaml"
  fi
  if [[ -n "${PUNCH_DATA_DIR:-}" ]]; then
    tasks_file="$PUNCH_DATA_DIR/tasks.txt"
  elif [[ -f "$snap_dir/.local/share/punch/tasks.txt" ]]; then
    tasks_file="$snap_dir/.local/share/punch/tasks.txt"
  else
    tasks_file="${XDG_DATA_HOME:-$HOME/.local/share}/punch/tasks.txt"
  fi

  if [[ "$command" == config ]]; then
    if [[ -r "$config_file" ]]; then
      local -a keys
      keys=("${(@f)$(awk '/^[A-Za-z_][A-Za-z0-9_-]*:/ {sub(/:.*/, ""); print}' "$config_file")}")
      compadd -- "${keys[@]}"
    fi
    return
  fi

  local line catname="" code i short fullcat
  local -A short_to_full
  local -a shorts tasks
  if [[ -r "$config_file" ]]; then
    while IFS= read -r line; do
      if [[ "$line" =~ '^[[:space:]]{2}([A-Za-z0-9 _-]+):[[:space:]]*$' ]]; then
        catname="${match[1]}"
      elif [[ "$line" =~ 'short:[[:space:]]*([A-Za-z0-9_]+)' ]]; then
        code="${match[1]}"
        shorts+=("$code")
        short_to_full[$code]="$catname"
      fi
    done < "$config_file"
  fi

  for ((i=3; i<CURRENT; i++)); do
    case "${words[i]}" in
      -t|--time) ((i+=1)) ;;
      --time=*|-v|--verbose) ;;
      *) args+=("${words[i]}") ;;
    esac
  done
  if (( ${#args[@]} == 0 )); then
    if [[ "$cur" == *: ]]; then
      short="${cur%:}"
      if [[ -n "$short" && -n "${short_to_full[$short]:-}" ]]; then
        compadd -- "$cur"
      fi
      return
    fi
    compadd -- "${shorts[@]}"
    return
  else
    short="${args[1]%:}"
    if (( ${#args[@]} == 1 )) && [[ "${args[1]}" != *: ]]; then
      compadd -- ':'
      return
    fi
    if (( ${#args[@]} > 2 )) || { (( ${#args[@]} == 2 )) && [[ "${args[2]}" != : ]]; }; then
      return
    fi
  fi
  [[ -n "$short" ]] || return 0
  fullcat="${short_to_full[$short]:-}"
  if [[ -n "$fullcat" && -r "$tasks_file" ]]; then
    tasks=("${(@f)$(awk -F'|' -v cat="$fullcat" '
      { gsub(/^[ \t]+|[ \t]+$/, "", $2);
        gsub(/^[ \t]+|[ \t]+$/, "", $3); }
      $2 == cat && $3 != "" { print $3 }
    ' "$tasks_file" | sort -u)}")
    compadd -- "${tasks[@]}"
  fi
}

if [[ "$ZSH_EVAL_CONTEXT" == *:file ]]; then
  compdef _punch_completion punch punch.py
else
  _punch_completion "$@"
fi
